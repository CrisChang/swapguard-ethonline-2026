{
  "name": "swapguard",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "mcp": "node --import tsx server/mcp.ts",
    "check:mcp": "node --import tsx scripts/check-mcp.ts",
    "record:agent-evidence": "node --import tsx scripts/record-agent-evidence.ts",
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "check:live": "tsx scripts/check-live.ts",
    "check:protection": "tsx scripts/check-protection.ts",
    "check:deployment": "tsx scripts/check-deployment.ts",
    "experiment:measure": "tsx scripts/measure-fork.ts",
    "experiment:replay": "tsx scripts/replay-tasks.ts",
    "check:task-fork": "tsx scripts/check-task-fork.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/server": "2.0.0",
    "hono": "^4.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.38.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^6.4.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.30.0"
  }
}
